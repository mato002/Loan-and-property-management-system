# Copy to capacitor.env (gitignored). Sync after changes: npm run cap:sync

# Gaitho Property Agency (production)
CAPACITOR_SERVER_URL=https://gaithoproperties.co.ke/property/tenant/login
CAPACITOR_ALLOW_CLEARTEXT=false

# Other entry points (swap URL if building a different APK):
# Landlord: https://gaithoproperties.co.ke/property/landlord/login
# Public home: https://gaithoproperties.co.ke/
# Staff (loan/property agent): https://gaithoproperties.co.ke/login

# Local LAN testing only:
# CAPACITOR_SERVER_URL=http://192.168.1.10:8000/property/tenant/login
# CAPACITOR_ALLOW_CLEARTEXT=true
