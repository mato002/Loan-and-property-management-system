APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Used for due dates, invoice months, and scheduled task times. Set to your region in production (e.g. Africa/Nairobi).
APP_TIMEZONE=UTC

# Safety switch: keep false in local to block accidental destructive DB commands
# (migrate:fresh, migrate:refresh, db:wipe, db:reset, schema:drop).
# Set to true only when you intentionally want to wipe/reset local data.
# ALLOW_DESTRUCTIVE_DB_COMMANDS=false

# Android APK (Capacitor): copy capacitor.env.example to capacitor.env — see docs/MOBILE-ANDROID.md
# CAPACITOR_SERVER_URL=https://gaithoproperties.co.ke/property/tenant/login

# Vite (CSS/JS): set APP_URL to the same host users type in the browser (not only localhost).
# If you use "npm run dev" and open the site from another phone/PC, either:
#   1) Run "npm run build" and delete public/hot so all devices load /build/* assets, or
#   2) Set VITE_DEV_BIND=true and VITE_DEV_HOST=YOUR_LAN_IP (e.g. 192.168.1.10) then restart "npm run dev".
# VITE_DEV_BIND=
# VITE_DEV_HOST=
# VITE_PORT=5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Loan module: SMS forwarder webhook (same JSON body style as property). Creates unposted M-Pesa payments when payer phone matches a loan client.
LOAN_SMS_INGEST_SECRET=
# Optional shortcut: if LOAN_SMS_INGEST_SECRET is left blank, Loan ingest falls back to PROPERTY_SMS_INGEST_SECRET.
# PROPERTY_SMS_INGEST_SECRET=replace-with-a-long-random-secret

# Super Admin: set true only if this install should show system-wide loan money totals on the SA dashboard.
# SUPERADMIN_SHOW_TENANT_FINANCIAL_AGGREGATES=false

# --- M-Pesa Daraja (STK + optional B2C loan disbursements) ---
# STK (pay-ins): required for tenant/landlord STK and similar flows.
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_STK_CALLBACK_URL=https://YOUR_PUBLIC_HOST/webhooks/mpesa/stk-callback
# MPESA_STK_SHORTCODE=
# MPESA_VERIFY_SSL=true
#
# B2C (loan disbursement payouts to customer phones): required for LoanBook → Record disbursement → M-Pesa + Retry.
# Initiator + SecurityCredential come from the Safaricom developer portal (B2C API user, encrypted credential).
# Result/Timeout URLs must be HTTPS and reachable by Safaricom (use ngrok on local dev).
# MPESA_B2C_SHORTCODE=
# MPESA_B2C_INITIATOR_NAME=
# MPESA_B2C_SECURITY_CREDENTIAL=
# MPESA_B2C_RESULT_URL=https://YOUR_PUBLIC_HOST/webhooks/mpesa/b2c-result
# MPESA_B2C_TIMEOUT_URL=https://YOUR_PUBLIC_HOST/webhooks/mpesa/b2c-result

# --- Property module: scheduled workflow automation ---
# When unset, automation follows Property → System setup → Workflow adjustments (checkbox).
# When set to true/false, overrides that database value for scheduled commands only (rent/water invoices, reminders, penalties).
# Production still requires OS cron: * * * * * cd /path/to/project && php artisan schedule:run
# See deploy/laravel-scheduler.cron.example and run: php artisan property:workflow-automation-status
# PROPERTY_WORKFLOW_AUTOMATION_ENABLED=true

# Property portal UI version (legacy vs ERP workspace redesign).
# false = original sidebar/pages; true = v2 workspace navigation and redesigned pages.
# After changing, run: php artisan optimize:clear
PROPERTY_UI_V2=false

# Property navigation shell mode (sidebar/header presentation only — pages unchanged).
# classic = full section sidebar (default) | workspace = thin workspace rail | hybrid = compact grouped sections
# After changing, run: php artisan optimize:clear
PROPERTY_NAV_MODE=classic

# --- Equity Bank API (paybill transaction sync) ---
# Required for the scheduled `fetch:equity-transactions` job and the
# Property → Equity → Trigger sync button. Leave ALL of these blank to
# disable the integration cleanly (the service short-circuits and logs a
# single warning per hour instead of a DNS error every 5 minutes).
# After changing these values run: php artisan config:clear
# EQUITY_API_BASE_URL=https://api.equitybankgroup.com
# EQUITY_API_USERNAME=
# EQUITY_API_PASSWORD=
# EQUITY_API_KEY=
# EQUITY_API_SECRET=
# EQUITY_API_AUTH_ENDPOINT=/oauth/token
# EQUITY_API_TRANSACTIONS_ENDPOINT=/paybill/transactions
# EQUITY_API_BALANCE_ENDPOINT=/accounts/balance
# EQUITY_API_TIMEOUT_SECONDS=25
# EQUITY_API_RETRY_TIMES=3
# EQUITY_API_RETRY_SLEEP_MS=500
# EQUITY_SYNC_INTERVAL_MINUTES=5

# --- Bulk SMS provider (Pradytec AI CRM) ---
# Used by dashboard Bulk SMS Balance and provider SMS sending.
# BULKSMS_API_URL=https://crm.pradytecai.com/api
# BULKSMS_CLIENT_ID=1
# BULKSMS_API_KEY=
# BULKSMS_SENDER_ID=
# BULKSMS_BALANCE_PATH=client/balance
# BULKSMS_TIMEOUT=20
# BULKSMS_VERIFY_SSL=true
# BULKSMS_BILLING_MODE=provider
# BULKSMS_DASHBOARD_BALANCE_SOURCE=provider
